# Tim Kofler – Webdesign (Apache 2.4, ALL-INKL)
Options -Indexes
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<Files ".user.ini">
  Require all denied
</Files>
# Versteckte Dateien (z. B. .env, .git, Sicherungen von Editoren) nie ausliefern
<FilesMatch "^\.|~$|\.(bak|old|orig|swp|log|sql)$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.tim-kofler\.at$ [NC]
  RewriteRule ^ https://tim-kofler.at%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^tim-kofler\.at$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://tim-kofler.at%{REQUEST_URI} [R=301,L]
  # Kurzlink für den QR-Code im Brief an Betriebe
  RewriteRule ^brief/?$ /?utm_source=brief&utm_campaign=referenzkunde#pakete [R=302,NE,L]
  # Kurzer Link für Flyer, Briefe und Karten zur Newsletter-Anmeldung mit Checkliste
  RewriteRule ^checkliste/?$ /newsletter/ [R=302,L]
  # Kurzlink für Story-Sticker und Briefe zum Sicherheits-Hinweis (PHP-Versionen); ?utm_source=… bleibt erhalten
  RewriteRule ^php/?$ /sicherheit/ [R=302,L]
  # Kurzlink für Werbung (Story, Google) zur Beispiel-Betriebs-App; ?utm_source=… bleibt erhalten
  RewriteRule ^app/?$ /beispiele/betriebs-app/ [R=302,L]
  # Kurzlinks für Briefe, Flyer und Werbung zu den beiden Apps
  RewriteRule ^betriebs-app/?$ /beispiele/betriebs-app/ [R=302,L]
  RewriteRule ^vereins-app/?$ /beispiele/verein-app/ [R=302,L]
  # Kurzlink für Werbung (Story-Sticker, Google) zum kostenlosen Webseiten-Entwurf; ?utm_source=… bleibt erhalten
  RewriteRule ^gratis/?$ /entwurf/ [R=302,L]
  # Die frühere „Vorschau in 60 Sekunden“ gibt es nicht mehr. /vorschau (QR-Code auf den gedruckten Briefen)
  # und alte Vorschau-Links führen zum Gratis-Entwurf; ?utm_source=… bleibt erhalten.
  RewriteRule ^vorschau(/.*)?$ /entwurf/ [R=302,L]
  # Alte Vorschau-Endpunkte bleiben beim Hochladen auf dem Server liegen, sind aber nicht mehr erreichbar.
  RewriteRule ^api/vorschau(-lib)?\.php(/|$) - [G,L]
</IfModule>
<If "%{HTTP_HOST} =~ /^(www\.)?tim-kofler\.at$/i">
  DirectoryIndex index.html index.php
  ErrorDocument 404 /404.html
  <IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # Friseur-Beispiel: Haarfarbe live testen braucht die Kamera (nur diese Seite) und WebAssembly
    # für die Haar-Erkennung im Browser. Alle anderen Seiten bleiben ohne Kamera und ohne WebAssembly.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" "expr=%{REQUEST_URI} !~ m#^/beispiele/friseur/#"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), interest-cohort=()" "expr=%{REQUEST_URI} =~ m#^/beispiele/friseur/#"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" "expr=%{REQUEST_URI} !~ m#^/(beispiele/friseur|demo/bunker)/#"
    # Bunker-Entwurf: YouTube-Videos des Vereins, erst nach Klick und ohne Cookies (youtube-nocookie)
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" "expr=%{REQUEST_URI} =~ m#^/demo/bunker/#"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" "expr=%{REQUEST_URI} =~ m#^/beispiele/friseur/#"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/wasm "access plus 30 days"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType application/manifest+json "access plus 1 day"
    ExpiresByType video/mp4 "access plus 30 days"
  </IfModule>
</If>
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/wasm .wasm
  AddType image/avif .avif
  AddType text/javascript .mjs
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain application/wasm application/xml text/xml
</IfModule>
