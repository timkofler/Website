# Nur die Endpunkte (anmelden.php, bestaetigen.php, chat.php …) sind von außen erreichbar, Bibliotheken und die KI-Anweisung nie.
Options -Indexes
<FilesMatch "^(lib\.php|[a-z0-9-]+-lib\.php|config\.example\.php|chat-anweisung\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex"
</IfModule>
