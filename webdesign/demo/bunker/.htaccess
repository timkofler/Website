# Entwurf für bunker.kollektiv: nicht in Suchmaschinen, nur mit Passwort (siehe _gate.php)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# Startseite ist index.php (die alte index.html wurde am Server gelöscht).
# Keine Umleitung von index.html: das DirectoryIndex der Haupt-.htaccess prüft index.html zuerst,
# eine Umleitung darauf würde /demo/bunker/ endlos weiterleiten.
DirectoryIndex index.php
<Files "_gate.php">
  Require all denied
</Files>
