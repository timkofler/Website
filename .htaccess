# CryptoX – Konfiguration für den ALL-INKL-Webspace (Apache 2.4)
#
# WICHTIG: Die Subdomains (dashboard., feedback., t01. … usw.) liegen als
# Unterordner in diesem Verzeichnis. Eine .htaccess wirkt auch auf alle
# Unterordner. Deshalb gelten alle Regeln unten NUR für crypto-x.at und
# www.crypto-x.at, die Subdomains bleiben unberührt.

Options -Indexes

# Interne Datei der automatischen Veröffentlichung nicht ausliefern
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- www → ohne www, immer HTTPS (nur Hauptdomain) ---
  RewriteCond %{HTTP_HOST} ^www\.crypto-x\.at$ [NC]
  RewriteRule ^ https://crypto-x.at%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://crypto-x.at%{REQUEST_URI} [R=301,L]

  # --- Alte WordPress-Adressen (301), nur Hauptdomain ---
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|feed)(/.*)?$ https://crypto-x.at/ [R=301,L]
  # WordPress-Archive, Technik-Pfade und Datums-Ordner (sonst 404/403 in der Search Console)
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^(wp-content|wp-includes|wp-json|comments|sample-page|kontakt)(/.*)?$ https://crypto-x.at/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^(category|tag|author|page)(/.*)?$ https://crypto-x.at/wissen/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^2025(/\d{2}(/\d{2})?)?/?$ https://crypto-x.at/wissen/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|s)=
  RewriteRule ^$ https://crypto-x.at/? [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^blog/?$ https://crypto-x.at/wissen/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^faqs/?$ https://crypto-x.at/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^portfolio/?$ https://crypto-x.at/wissen/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^portfolio/bitcoin/?$ https://crypto-x.at/2025/03/19/kryptowaehrungen-fuer-einsteiger-ein-kompletter-leitfaden-fuer-den-einstieg/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^portfolio/ethereum-eth/?$ https://crypto-x.at/2025/03/19/kryptowaehrungen-fuer-einsteiger-ein-kompletter-leitfaden-fuer-den-einstieg/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^portfolio/solana-sol/?$ https://crypto-x.at/2025/03/19/kryptowaehrungen-fuer-einsteiger-ein-kompletter-leitfaden-fuer-den-einstieg/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^cookie-richtlinie-eu/?$ https://crypto-x.at/datenschutz/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^3-exklusive-cointipps/?$ https://crypto-x.at/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^5-exklusive-cointipps/?$ https://crypto-x.at/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^2025/01/27/the-role-of-color-psychology-in-branding-2/?$ https://crypto-x.at/2025/01/27/die-bekanntesten-trading-strategien/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^referenz/?$ https://tim-kofler.at/?utm_source=instagram&utm_campaign=referenzkunde#pakete [R=302,L,NE]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^webseite/?$ https://tim-kofler.at/?utm_source=instagram&utm_campaign=webdesign#anfrage [R=302,L,NE]
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^webseite-erstellen-lassen(/.*)?$ https://tim-kofler.at/ [R=301,L]
  # Alte Kopie von tim-kofler.at unter /webdesign/ (bis 2026-10-15), sonst doppelter Inhalt bei Google
  RewriteCond %{HTTP_HOST} ^crypto-x\.at$ [NC]
  RewriteRule ^webdesign(?:/(.*))?$ https://tim-kofler.at/$1 [R=301,L]
</IfModule>

# --- Nur für die Hauptdomain: Fehlerseite, Sicherheits-Header, Cache ---
<If "%{HTTP_HOST} =~ /^(www\.)?crypto-x\.at$/i">
  # Auf der Hauptdomain hat index.html Vorrang (vor alter index.php/index.htm).
  # Die Subdomains behalten die Standard-Reihenfolge des Servers.
  DirectoryIndex index.html
  ErrorDocument 404 /404.html
  <IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
  </IfModule>
</If>

# --- Zeichensatz, Typen, Komprimierung (unschädlich für alle Ordner) ---
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
